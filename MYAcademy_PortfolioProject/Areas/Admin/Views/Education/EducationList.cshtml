@model List<Education>

@{
    ViewData["Title"] = "EducationList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Eğitim Hayatım</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/Education/CreateEducation" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Ekle</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Başlık</th>
                        <th>Kurum</th>
                        <th>Açıklama</th>
                        <th>Rozet</th>
                        <th style="width: 90px; text-align: center;">Güncelle</th>
                        <th style="width: 90px; text-align: center;">Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.EducationId.ToString("00")</td>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-mortarboard"></i>
                                    </div>
                                    <span class="exp-title-text">@item.Title</span>
                                </div>
                            </td>
                            <td>@item.Institution</td>
                            <td>
                                <small class="text-muted d-block"
                                       style="max-width:360px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    @item.Description
                                </small>
                            </td>
                            <td><span class="work-type-badge">@item.Badge</span></td>
                            <td style="text-align: center;">
                                <a href="/Admin/Education/UpdateEducation/@item.EducationId" class="btn-action-icon btn-edit" title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/Education/DeleteEducation/@item.EducationId" class="btn-action-icon btn-delete" title="Sil"
                                   onclick="return confirm('Bu eğitim kaydını silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>