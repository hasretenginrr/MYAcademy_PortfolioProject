@model Skill

@{
    ViewData["Title"] = "CreateSkill";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Yetenek Ekle</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/Skill/SkillList" class="btn-pastel-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Listeye Dön</span>
            </a>
        </div>
    </div>

    <div class="side-drawer-card">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label-custom">Başlık</label>
                    <input type="text" asp-for="Title" class="form-control-custom" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">İkon (Bootstrap Icons sınıfı)</label>
                    <input type="text" asp-for="IconUrl" class="form-control-custom" placeholder="Örn: bi bi-server" />
                    <span asp-validation-for="IconUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">Seviye (0-100)</label>
                    <input type="number" asp-for="Level" min="0" max="100" class="form-control-custom" />
                    <span asp-validation-for="Level" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label-custom">Açıklama</label>
                    <textarea asp-for="Description" class="form-control-custom" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Admin/Skill/SkillList" class="btn-pastel-secondary" style="padding: 8px 14px;">Vazgeç</a>
                    <button type="submit" class="btn-pastel-primary" style="padding: 8px 20px;">
                        <i class="bi bi-check-lg"></i>
                        <span>Yeteneği Kaydet</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

</main>