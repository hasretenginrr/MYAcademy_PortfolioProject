@model About

@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Hakkımda Güncelle</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/About/AboutList" class="btn-pastel-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Listeye Dön</span>
            </a>
        </div>
    </div>

    <div class="side-drawer-card">
        <form method="post">
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label-custom">Başlık</label>
                    <input type="text" asp-for="Title" class="form-control-custom" />
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">Görsel URL</label>
                    <input type="text" asp-for="ImageUrl" class="form-control-custom" />
                </div>
                <div class="col-12">
                    <label class="form-label-custom">Açıklama</label>
                    <textarea asp-for="Description" class="form-control-custom" rows="4"></textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Deneyim Yılı</label>
                    <input type="text" asp-for="ExperienceYears" class="form-control-custom" />
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Kurs Sayısı</label>
                    <input type="text" asp-for="CourseCount" class="form-control-custom" />
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Sertifika Sayısı</label>
                    <input type="text" asp-for="CertificateCount" class="form-control-custom" />
                </div>
                <div class="col-12">
                    <label class="form-label-custom">CV Linki</label>
                    <input type="text" asp-for="CvUrl" class="form-control-custom" />
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Admin/About/AboutList" class="btn-pastel-secondary" style="padding: 8px 14px;">Vazgeç</a>
                    <button type="submit" class="btn-pastel-primary" style="padding: 8px 20px;">
                        <i class="bi bi-check-lg"></i>
                        <span>Değişiklikleri Kaydet</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

</main>