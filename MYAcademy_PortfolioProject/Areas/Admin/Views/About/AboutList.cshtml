@model List<About>

@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Hakkımda</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/About/CreateAbout" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Ekle</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Görsel</th>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th>Deneyim Yılı</th>
                        <th>Kurs Sayısı</th>
                        <th>Sertifika Sayısı</th>
                        <th style="width: 90px; text-align: center;">Güncelle</th>
                        <th style="width: 90px; text-align: center;">Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.Id.ToString("00")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Title"
                                         style="width:44px; height:44px; object-fit:cover; border-radius:8px;" />
                                }
                            </td>
                            <td><span class="exp-title-text">@item.Title</span></td>
                            <td>
                                <small class="text-muted d-block"
                                       style="max-width:320px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    @item.Description
                                </small>
                            </td>
                            <td><span class="work-type-badge">@item.ExperienceYears</span></td>
                            <td><span class="work-type-badge">@item.CourseCount</span></td>
                            <td><span class="work-type-badge">@item.CertificateCount</span></td>
                            <td style="text-align: center;">
                                <a href="/Admin/About/UpdateAbout/@item.Id" class="btn-action-icon btn-edit" title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/About/DeleteAbout/@item.Id" class="btn-action-icon btn-delete" title="Sil"
                                   onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>