@model List<Category>

@{
    ViewData["Title"] = "CategoryList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Proje Kategorileri</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/Category/CreateCategory" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Ekle</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Kategori Adı</th>
                        <th>Proje Sayısı</th>
                        <th style="width: 90px; text-align: center;">Güncelle</th>
                        <th style="width: 90px; text-align: center;">Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.CategoryId.ToString("00")</td>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-folder2"></i>
                                    </div>
                                    <span class="exp-title-text">@item.CategoryName</span>
                                </div>
                            </td>
                            <td>
                                <span class="status-pill status-active">
                                    <i class="bi bi-code-slash me-1"></i>@item.Projects.Count proje
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/Category/UpdateCategory/@item.CategoryId" class="btn-action-icon btn-edit" title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/Category/DeleteCategory/@item.CategoryId" class="btn-action-icon btn-delete" title="Sil"
                                   onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz? Kategoriye bağlı projeler de silinir.');">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>