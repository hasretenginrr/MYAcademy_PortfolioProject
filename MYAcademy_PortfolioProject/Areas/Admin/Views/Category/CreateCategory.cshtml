@model Category

@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Kategori Ekle</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/Category/CategoryList" class="btn-pastel-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Listeye Dön</span>
            </a>
        </div>
    </div>

    <div class="side-drawer-card">
        <form method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label-custom">Kategori Adı</label>
                    <input type="text" asp-for="CategoryName" class="form-control-custom" />
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Admin/Category/CategoryList" class="btn-pastel-secondary" style="padding: 8px 14px;">Vazgeç</a>
                    <button type="submit" class="btn-pastel-primary" style="padding: 8px 20px;">
                        <i class="bi bi-check-lg"></i>
                        <span>Kategoriyi Kaydet</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

</main>