@model List<Project>

@{
    ViewData["Title"] = "ProjectList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var categories = (List<Category>)ViewBag.Categories;
    int? selectedCategory = ViewBag.SelectedCategory;
    string sort = ViewBag.Sort ?? "newest";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Projelerim</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/Project/CreateProject" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Ekle</span>
            </a>
        </div>
    </div>


    <div class="data-table-card">

        <form method="get" action="/Admin/Project/ProjectList" class="table-filter-bar">
            <div class="filters-left-group">
                <select name="categoryId" class="filter-select" onchange="this.form.submit()">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId" selected="@(selectedCategory == c.CategoryId)">@c.CategoryName</option>
                    }
                </select>

                <select name="sort" class="filter-select" onchange="this.form.submit()">
                    <option value="newest" selected="@(sort == "newest")">Sıralama: En yeni</option>
                    <option value="oldest" selected="@(sort == "oldest")">Sıralama: En eski</option>
                    <option value="title" selected="@(sort == "title")">Sıralama: Ada göre (A-Z)</option>
                </select>
            </div>
        </form>

        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Proje Adı</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th style="width: 90px; text-align: center;">Güncelle</th>
                        <th style="width: 90px; text-align: center;">Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.ProjectId.ToString("00")</td>
                            <td>
                                <div class="experience-title-cell">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="" style="width:40px; height:40px; object-fit:cover; border-radius:8px;" />
                                    }
                                    else
                                    {
                                        <div class="exp-icon-bullet"><i class="bi bi-code-slash"></i></div>
                                    }
                                    <div>
                                        <span class="exp-title-text">@item.ProjectTitle</span>
                                        <small class="text-muted d-block">@item.CreatedDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="work-type-badge">@item.Category?.CategoryName</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-passive">Pasif</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="btn-action-icon btn-edit" title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/Project/DeleteProject/@item.ProjectId" class="btn-action-icon btn-delete" title="Sil"
                                   onclick="return confirm('Bu projeyi silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>