@model MYAcademy_PortfolioProject.Entities.Message

@{
    ViewData["Title"] = "MessageDetail";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@Model.Subject</h5>
            <span class="badge @(Model.IsRead ? "bg-success" : "bg-warning text-dark")">
                @(Model.IsRead ? "Okundu" : "Okunmadı")
            </span>
        </div>
        <div class="card-body">
            <p class="mb-1"><strong>Gönderen:</strong> @Model.SenderName</p>
            <p class="mb-1"><strong>E-posta:</strong> <a href="mailto:@Model.SenderEmail">@Model.SenderEmail</a></p>
            <p class="text-muted small">@Model.SendDate.ToString("dd MMMM yyyy HH:mm")</p>
            <hr />
            <p style="white-space: pre-line;">@Model.MessageDetail</p>
        </div>
        <div class="card-footer">
            <a href="/Admin/Message/MessageList" class="btn btn-light">Listeye Dön</a>
            <a href="/Admin/Message/UpdateMessage/@Model.MessageId" class="btn btn-success">Düzenle</a>
            <a href="/Admin/Message/DeleteMessage/@Model.MessageId" class="btn btn-danger"
               onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">Sil</a>
        </div>
    </div>
</div>