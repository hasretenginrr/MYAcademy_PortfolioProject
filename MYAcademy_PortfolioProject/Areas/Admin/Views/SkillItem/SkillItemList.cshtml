@model List<SkillItem>

@{
    ViewData["Title"] = "SkillItemList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yetenek Öğeleri</h1>
        </div>
        <div class="header-actions">
            <a href="/Admin/SkillItem/CreateSkillItem" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Ekle</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Öğe Adı</th>
                        <th>Yetenek</th>
                        <th style="width: 90px; text-align: center;">Güncelle</th>
                        <th style="width: 90px; text-align: center;">Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.SkillItemId.ToString("00")</td>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-tag"></i>
                                    </div>
                                    <span class="exp-title-text">@item.SkillItemTitle</span>
                                </div>
                            </td>
                            <td><span class="work-type-badge">@item.Skill?.Title</span></td>
                            <td style="text-align: center;">
                                <a href="/Admin/SkillItem/UpdateSkillItem/@item.SkillItemId" class="btn-action-icon btn-edit" title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/SkillItem/DeleteSkillItem/@item.SkillItemId" class="btn-action-icon btn-delete" title="Sil"
                                   onclick="return confirm('Bu yetenek öğesini silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>